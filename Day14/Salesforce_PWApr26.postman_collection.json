              "console.log(responseGenerateToken.instance_url);\r",
              "\r",
              "let instanceUrl = responseGenerateToken.instance_url; // get instance_url from response \r",
              "\r",
              "pm.globals.set(\"url\",instanceUrl) \r",
              "\r",
              "//pm.globals.set(key,value)  syntax to set the value into the global table\r",
              "\r",
              "console.log(responseGenerateToken.access_token) // get access_token from response \r",
